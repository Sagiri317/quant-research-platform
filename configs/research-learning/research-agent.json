{
  "question": "在固定标签和窗口上比较公式搜索的验证期 RankIC；保留失败与未定义结果，不使用测试期反馈。",
  "protocol": {
    "label": "forward_return_1d",
    "train_window": {
      "start": "2018-01-01",
      "end": "2019-11-29"
    },
    "validation_window": {
      "start": "2020-01-02",
      "end": "2020-11-30"
    },
    "test_window": {
      "start": "2021-01-04",
      "end": "2021-12-31"
    },
    "costs": {},
    "metric": "validation_incremental_rank_ic"
  },
  "tools": {
    "search": {
      "operation": "search-factors",
      "config": {
        "dataset": "data/research/factor_search",
        "columns": [
          "momentum_20d",
          "volatility_20d"
        ],
        "baseline_columns": [],
        "label": "protocol:label",
        "train_window": "protocol:train_window",
        "validation_window": "protocol:validation_window",
        "train_cutoff": "2019-12-31",
        "selection_cutoff": "2020-12-31",
        "method": "random",
        "budget": 100,
        "max_depth": 3,
        "windows": [
          5,
          20
        ],
        "seed": 42,
        "output": "results/learning/search.json"
      },
      "vary": {
        "columns": [
          [
            "momentum_20d"
          ],
          [
            "volatility_20d"
          ],
          [
            "momentum_20d",
            "volatility_20d"
          ]
        ]
      },
      "metrics": {
        "validation_incremental_rank_ic": {
          "member": "",
          "column": "validation_score",
          "reduction": "mean"
        }
      }
    }
  },
  "budget": {
    "max_requests": 12,
    "max_experiments": 10,
    "wall_seconds": 3600
  },
  "output": "results/learning/agent",
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-6-luna",
    "credential_env": "QRP_RESEARCH_API_KEY",
    "max_output_tokens": 128000,
    "reasoning_effort": "high",
    "timeout_seconds": 300
  },
  "sandbox": {
    "image": "qrp-research:local",
    "inputs": {
      "development": "data/research/development_only"
    },
    "user": "1000:1000",
    "cpus": 4,
    "memory": "8g",
    "pids_limit": 256,
    "metrics": {
      "score": {
        "member": "metrics.json",
        "column": "score",
        "reduction": "mean"
      }
    }
  }
}
