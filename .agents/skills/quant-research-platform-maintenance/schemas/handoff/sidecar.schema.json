{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QRP handoff sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "zip_filename",
    "handoff_package_path",
    "handoff_sidecar_path",
    "zip_sha256",
    "artifact_manifest_sha256",
    "branch",
    "base",
    "final_head",
    "generated_at_utc",
    "status_summary",
    "advisory_reviews"
  ],
  "properties": {
    "schema_id": {
      "const": "qrp-handoff-sidecar"
    },
    "zip_filename": {
      "type": "string"
    },
    "handoff_package_path": {
      "type": "string"
    },
    "handoff_sidecar_path": {
      "type": "string"
    },
    "zip_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branch": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "final_head": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "status_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation",
        "tests",
        "package_smoke",
        "profile_smoke",
        "private_smoke_run_level",
        "private_smoke_child_checks",
        "baseline_compare",
        "governance",
        "code_map",
        "handoff_verify",
        "handoff_safety",
        "blocked_count",
        "fail_count"
      ],
      "properties": {
        "validation": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "tests": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "package_smoke": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "profile_smoke": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "private_smoke_run_level": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "private_smoke_child_checks": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "baseline_compare": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "governance": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "code_map": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "handoff_verify": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "handoff_safety": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "advisory_reviews": {
      "type": "object",
      "additionalProperties": {
        "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
      }
    }
  }
}
