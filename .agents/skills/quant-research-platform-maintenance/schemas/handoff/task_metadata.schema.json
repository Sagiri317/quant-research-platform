{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QRP handoff task metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "mode",
    "slug",
    "branch",
    "base",
    "final_head"
  ],
  "properties": {
    "schema_id": {
      "const": "qrp-handoff-task-metadata"
    },
    "mode": {
      "enum": ["evidence", "pr_closure"]
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "final_head": {
      "type": "string",
      "minLength": 1
    },
    "pr_url": {
      "type": "string",
      "minLength": 1
    },
    "task_title": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "handoff_package_path": {
      "type": "string",
      "minLength": 1
    },
    "handoff_sidecar_path": {
      "type": "string",
      "minLength": 1
    },
    "scope_summary": {
      "type": "string"
    },
    "fixed_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_list": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "pr_closure"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["pr_url"]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "evidence"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "not": {
          "required": ["pr_url"]
        }
      }
    }
  ]
}
