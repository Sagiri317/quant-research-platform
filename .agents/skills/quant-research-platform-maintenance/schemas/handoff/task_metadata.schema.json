{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QRP handoff task metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "slug",
    "branch",
    "base",
    "final_head"
  ],
  "properties": {
    "schema_version": {
      "const": "handoff-task-metadata/0.1"
    },
    "mode": {
      "enum": ["evidence", "pr_closure"]
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "final_head": {
      "type": "string",
      "minLength": 1
    },
    "pr_url": {
      "type": "string",
      "minLength": 1
    },
    "task_title": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "handoff_package_path": {
      "type": "string",
      "minLength": 1
    },
    "handoff_sidecar_path": {
      "type": "string",
      "minLength": 1
    },
    "scope_summary": {
      "type": "string"
    },
    "fixed_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "not_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit_list": {
      "type": "array"
    },
    "validation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "checks"],
      "properties": {
        "schema_version": {
          "const": "handoff-validation-evidence/0.1"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "evidence"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "handoff_evidence": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "properties": {
        "smoke-compare-status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "record_status",
            "overall_smoke_compare_status",
            "results"
          ],
          "not": {
            "required": ["status"]
          },
          "properties": {
            "schema_version": {
              "const": "handoff-smoke-compare-status/0.1"
            },
            "record_status": {
              "const": "PASS"
            },
            "overall_smoke_compare_status": {
              "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
            },
            "results": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "status", "reason"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "status"],
        "properties": {
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
          }
        }
      }
    },
    "handoff_markdown_evidence": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_tree_scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "scan_groups": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retired_text": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "retired_governance_paths": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "retired_path_names": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "python_symbols": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "synthesized_strings": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "active_test_literals": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "structured_keys": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "governance_truth": {
              "$ref": "#/$defs/source_tree_scan_group"
            },
            "sensitive_negative_literals": {
              "$ref": "#/$defs/source_tree_scan_group"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source_tree_scan_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "finding_count", "findings"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "pr_closure"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "required": ["pr_url"]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "evidence"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "not": {
          "required": ["pr_url"]
        }
      }
    }
  ]
}
